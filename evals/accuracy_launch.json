{
  "name": "cesi_accuracy_launch",
  "version": "2026-05-launch-01",
  "client_id": "default",
  "purpose": "P0-проверка точности перед первым demo-prod запуском стоматологического бота ЦЭСИ.",
  "source_notes": [
    "Собрано из eval.md, MD_CHUNKS_INDEX.md, service_catalog.json, prices.json и текущей архитектуры /ask.",
    "Это launch-eval: не полный eval на 80-90 кейсов, а быстрый набор для блокеров запуска.",
    "Поля *_any нужны, чтобы runner не падал на допустимых вариантах маршрута, где архитектура допускает несколько путей к правильному источнику.",
    "Запуск проверки: поднять бота, затем `python tools/run_accuracy.py` (кейсы в evals/accuracy_launch.json — копируйте туда изменения из этого черновика)."
  ],
  "pass_criteria": {
    "contacts": "100%",
    "booking": "100%",
    "critical_price": "no_wrong_prices",
    "do_you_do_X": "100%",
    "hallucinated_numbers": "0 manual findings in sampled cases",
    "no_cross_topic_critical": true
  },
  "fields_guide": {
    "expected.route": "строгое значение route из turn_complete/request.ctx",
    "expected.route_any": "любой route из списка допустим",
    "expected.doc_id": "строгое значение meta.doc_id или doc_id из события",
    "expected.doc_id_any": "любой doc_id из списка допустим; null допустим для guided/no-content",
    "expected.h3_id_any": "любой h3_id из списка допустим",
    "must_contain": "подстроки, которые должны встретиться в answer; проверять lower/ё=е, но цифры строго",
    "must_not_contain": "подстроки, которых не должно быть в answer",
    "turns": "многоходовый кейс; runner должен сохранять sid между ходами"
  },
